---
import { Image } from "astro:assets";
import gameShot from "../assets/number-one-rich.png";
import { content, site, type Lang } from "../i18n";
import Footer from "./Footer.astro";

const { lang } = Astro.props as { lang: Lang };
const c = content[lang];
---

<main>
  <!-- ========== HERO ========== -->
  <section class="relative isolate flex min-h-svh flex-col justify-end overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <Image
        src={gameShot}
        alt=""
        widths={[960, 1440, 1920]}
        sizes="100vw"
        loading="eager"
        decoding="async"
        class="h-full w-full scale-110 object-cover opacity-45 blur-[2px]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/85 to-ink/40"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_75%_15%,rgba(255,201,60,0.16),transparent_55%)]"></div>
      <div class="grid-lines absolute inset-0 opacity-[0.12]"></div>
    </div>

    <div class="mx-auto w-full max-w-7xl px-6 pb-14 pt-32 sm:px-10 sm:pb-20">
      <p class="eyebrow" data-reveal>{c.hero.eyebrow}</p>

      <h1
        class:list={[
          "font-display text-balance mt-6 font-black leading-[0.9] tracking-[-0.03em]",
          lang === "en"
            ? "text-[clamp(2.5rem,7.4vw,7rem)]"
            : "text-[clamp(3rem,10.5vw,8.5rem)]",
        ]}
        data-reveal
      >
        {c.hero.title}
      </h1>
      <p
        class="font-display mt-5 text-[clamp(1.5rem,4.6vw,3.75rem)] font-black uppercase leading-none tracking-[-0.01em] text-outline"
        data-reveal
      >
        {c.hero.stroke}
      </p>

      <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end" data-reveal>
        <p class="max-w-xl text-base leading-relaxed text-paper/75 sm:text-lg">
          {c.hero.lead}
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={site.steam} target="_blank" rel="noreferrer" class="cta cta-primary">
            {c.hero.ctaPrimary}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7M9 7h8v8" />
            </svg>
          </a>
          <a href={site.appStore} target="_blank" rel="noreferrer" class="cta cta-outline">
            {c.hero.ctaSecondary}
          </a>
        </div>
      </div>

      <div class="mt-14 grid max-w-2xl grid-cols-3 gap-4 border-t border-white/10 pt-8" data-reveal>
        {c.hero.stats.map((stat) => (
          <div>
            <p class="font-display text-2xl font-black tracking-tight text-gold sm:text-3xl">
              {stat.value}
            </p>
            <p class="mt-1 text-[10px] leading-relaxed tracking-[0.14em] text-mute sm:text-[11px]">
              {stat.label}
            </p>
          </div>
        ))}
      </div>
    </div>

    <div class="pointer-events-none absolute bottom-6 right-6 hidden items-center gap-3 text-[10px] uppercase tracking-[0.25em] text-mute lg:flex">
      <span>{c.hero.scroll}</span>
      <span class="h-10 w-px bg-gradient-to-b from-gold/80 to-transparent"></span>
    </div>
  </section>

  <!-- ========== FEATURED GAME ========== -->
  <section id="games" class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 sm:px-10">
      <div class="border-b border-white/10 pb-8" data-reveal>
        <p class="eyebrow">{c.games.label}</p>
        <h2 class="font-display text-balance mt-5 text-[clamp(2rem,4.5vw,3.5rem)] font-black leading-[1.02] tracking-[-0.02em]">
          {c.games.heading}
        </h2>
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16">
        <a
          href={site.steam}
          target="_blank"
          rel="noreferrer"
          class="group relative block overflow-hidden rounded-3xl border border-white/10 bg-ink-soft shadow-[0_30px_80px_-40px_rgba(0,0,0,0.9)]"
          data-reveal
        >
          <Image
            src={gameShot}
            alt={c.games.name}
            widths={[720, 1080, 1440]}
            sizes="(min-width: 1024px) 620px, 100vw"
            loading="lazy"
            decoding="async"
            class="aspect-video w-full object-cover transition duration-700 ease-out group-hover:scale-[1.04]"
          />
          <span class="absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-transparent"></span>
          <span class="absolute left-5 top-5 rounded-full bg-ink/70 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-gold backdrop-blur">
            ★ {c.games.badge}
          </span>
          <span class="absolute bottom-5 right-5 flex h-11 w-11 items-center justify-center rounded-full bg-gold text-ink transition group-hover:bg-lime">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7M9 7h8v8" />
            </svg>
          </span>
        </a>

        <div data-reveal>
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-gold">{c.games.tag}</p>
          <h3 class="font-display mt-3 text-3xl font-black tracking-tight sm:text-4xl">{c.games.name}</h3>
          <p class="mt-5 text-sm leading-relaxed text-mute sm:text-base">{c.games.desc}</p>

          <ul class="mt-7 space-y-3.5">
            {c.games.playlist.map((item) => (
              <li class="flex items-start gap-3 text-sm text-paper/85">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold"></span>
                {item}
              </li>
            ))}
          </ul>

          <div class="mt-9 flex flex-wrap gap-3">
            <a href={site.steam} target="_blank" rel="noreferrer" class="cta cta-primary">
              {c.hero.ctaPrimary}
            </a>
            <a href={site.appStore} target="_blank" rel="noreferrer" class="cta cta-outline">
              {c.hero.ctaSecondary}
            </a>
          </div>
        </div>
      </div>

      <p class="mt-12 text-xs uppercase tracking-[0.2em] text-mute" data-reveal>{c.games.more}</p>
    </div>
  </section>

  <!-- ========== HOW TO PLAY ========== -->
  <section id="play" class="border-y border-white/10 bg-ink-soft py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 sm:px-10">
      <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div class="self-start lg:sticky lg:top-28" data-reveal>
          <p class="eyebrow">{c.how.label}</p>
          <h2 class="font-display text-balance mt-5 text-[clamp(2rem,4.5vw,3.5rem)] font-black leading-[1.05] tracking-[-0.02em]">
            {c.how.heading}
          </h2>
          <p class="mt-6 max-w-md text-sm leading-relaxed text-mute sm:text-base">{c.how.lead}</p>
        </div>

        <ol class="grid gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10 sm:grid-cols-2" data-reveal>
          {c.how.steps.map((step) => (
            <li class="group bg-ink p-8 transition-colors duration-300 hover:bg-ink-soft sm:p-10">
              <span class="font-display block text-5xl font-black leading-none text-white/10 transition-colors duration-300 group-hover:text-gold/40 sm:text-6xl">
                {step.n}
              </span>
              <h3 class="mt-7 text-lg font-bold tracking-tight text-paper sm:text-xl">{step.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-mute">{step.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ========== ABOUT ========== -->
  <section id="about" class="relative py-24 sm:py-32">
    <div class="mx-auto grid max-w-7xl items-center gap-14 px-6 sm:px-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
      <div data-reveal>
        <p class="eyebrow">{c.about.label}</p>
        <h2 class="font-display text-balance mt-6 whitespace-pre-line text-[clamp(2rem,4.8vw,3.75rem)] font-black leading-[1.04] tracking-[-0.02em]">
          {c.about.heading}
        </h2>
        <p class="mt-8 max-w-2xl text-base leading-relaxed text-mute sm:text-lg">{c.about.body}</p>
        <div class="mt-10 flex flex-wrap items-center gap-6 border-t border-white/10 pt-8 text-xs uppercase tracking-[0.2em] text-mute">
          <span>{site.domain}</span>
          <a href={`mailto:${site.email}`} class="normal-case tracking-normal text-paper/90 transition hover:text-gold">
            {site.email}
          </a>
        </div>
      </div>

      <div class="relative" data-reveal>
        <div class="absolute -inset-6 rounded-[2.5rem] bg-gold/10 blur-3xl"></div>
        <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-b from-white/[0.06] to-transparent p-8 sm:p-10">
          <div class="grid-lines absolute inset-0 opacity-20"></div>
          <div class="relative">
            <img src="/black_white_logo.png" width="72" height="72" alt={c.brand} class="h-16 w-16 rounded-xl ring-1 ring-white/10" />
            <p class="font-display mt-10 text-[clamp(2.5rem,5vw,4rem)] font-black uppercase leading-[0.88] tracking-[-0.02em] text-outline">
              Black<br />White
            </p>
            <p class="mt-8 border-t border-white/10 pt-6 text-sm leading-relaxed text-paper/70">
              “{c.about.quote}”
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== CONTACT ========== -->
  <section id="contact" class="relative overflow-hidden border-t border-white/10 bg-ink-soft py-24 sm:py-32">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_120%,rgba(255,201,60,0.18),transparent_60%)]"></div>
    <div class="relative mx-auto max-w-3xl px-6 text-center sm:px-10" data-reveal>
      <p class="eyebrow">{c.contact.label}</p>
      <h2 class="font-display text-balance mx-auto mt-6 max-w-2xl text-[clamp(2rem,4.5vw,3.5rem)] font-black leading-[1.06] tracking-[-0.02em]">
        {c.contact.heading}
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-sm leading-relaxed text-mute sm:text-base">{c.contact.body}</p>
      <a
        href={`mailto:${site.email}`}
        class="mt-10 inline-block break-all font-display text-2xl font-black tracking-tight text-gold underline decoration-gold/30 decoration-2 underline-offset-8 transition hover:text-lime hover:decoration-lime/50 sm:text-4xl"
      >
        {site.email}
      </a>
    </div>
  </section>
</main>

<Footer lang={lang} />
