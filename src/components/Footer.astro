---
import { content, site, type Lang } from "../i18n";

const { lang } = Astro.props as { lang: Lang };
const c = content[lang];
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-ink-soft">
  <div class="mx-auto max-w-7xl px-6 py-12 sm:px-10">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="flex items-start gap-3">
        <img src="/black_white_logo.png" width="40" height="40" alt="" class="h-10 w-10 rounded-lg ring-1 ring-white/10" />
        <div>
          <p class="text-sm font-black tracking-wide">{c.brand}</p>
          <p class="mt-1 text-xs text-mute">{c.footer.note}</p>
        </div>
      </div>

      <div class="flex flex-col gap-3 md:items-end">
        <a
          href={`mailto:${site.email}`}
          class="text-sm font-semibold text-paper/90 transition hover:text-gold"
        >
          {site.email}
        </a>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-mute">
          <a href={site.steam} target="_blank" rel="noreferrer" class="transition hover:text-gold">Steam</a>
          <a href={site.appStore} target="_blank" rel="noreferrer" class="transition hover:text-gold">App Store</a>
          <a href={c.switchHref} class="transition hover:text-gold">{c.switchLabel}</a>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-white/10 pt-6 text-xs text-mute">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-6">
        <a
          href="https://beian.mps.gov.cn/#/query/webSearch?code=35040002000232"
          rel="noreferrer"
          target="_blank"
          class="inline-flex items-center gap-2 transition hover:text-gold"
        >
          <img src="/gongan_icon.png" width="16" height="16" alt="" class="h-4 w-4" />
          闽公网安备35040002000232号
        </a>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer" class="transition hover:text-gold">
          闽ICP备2025092844号-1
        </a>
      </div>
      <p>Copyright © {year} {site.domain} · {c.footer.rights}</p>
    </div>
  </div>
</footer>
