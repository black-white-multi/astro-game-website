---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="BlackWhite">
  <div 
    class="hero min-h-screen"
    style="background-image: url(/number-one-rich.png);">
    <div class="hero-content text-white text-center">
      <div class="max-w-md">
        <h1 class="mb-5 text-5xl font-bold color">Number One Rich</h1>
        <p class="mb-5">
          Number one rich is an 8-player board game. You roll the dice to determine the number of steps you take. You can buy land and upgrade buildings. When you pass through other players' land, you must pay rent. You can get the first place by bankrupting other players.
        </p>
        <button class="btn btn-primary">
          <a
            href="https://store.steampowered.com/app/1455130"
            target={"_blank"}
          >
          STEAM
          </a>
        </button>
        <button class="btn btn-secondary">
          <a
            href="https://apps.apple.com/app/id1458195523"
            target={"_blank"}
          >
          APPSTORE
          </a>
        </button>
      </div>
    </div>
  </div>
  <div class="flex w-full flex-col">
    <div class="card bg-base-300 rounded-box grid place-items-center">
      <div class="divider">CONTACT</div>
      <div class="divider">For support,questions,and advice regarding our games,plaease email</div>
      <div class="divider">sprite2345@gmail.com</div>
    </div>
  </div>
  <footer class="footer footer-center bg-base-300 text-base-content p-4">
    <aside>
      <p><a href="https://beian.miit.gov.cn/" target="_blank">闽ICP备2025092844号-1</a></p>
      <p>Copyright © {new Date().getFullYear()} - All right reserved by blackwhite.fun</p>
    </aside>
  </footer>
</BaseLayout>
